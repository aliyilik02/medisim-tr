{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm run:*)",
      "Bash(npm ls:*)",
      "Bash(npm audit)",
      "Bash(npx tsc:*)",
      "Bash(npx vite:*)",
      "Bash(npx:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add .)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(rm src/*)",
      "Bash(rm -r src/*)",
      "Bash(rm dist/*)",
      "Bash(rm -r dist/*)",
      "Bash(rm -rf dist)",
      "Bash(rm -rf node_modules)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(npm uninstall:*)",
      "Bash(git reset --hard:*)",
      "Bash(git revert:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ..:*)",
      "Bash(rm /*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(npm publish:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(sudo:*)"
    ]
  },
  "env": {
    "PROJECT": "MediSim TR",
    "LANG_PREFERENCE": "tr"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const i=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8'));const p=i.tool_input?.file_path||'';if(p.includes('src/data/scenarios/')&&p.endsWith('.ts')){console.log('[hook] Senaryo değiştirildi: '+p+' — klinik review öneriliyor');}\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const i=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8'));const cmd=i.tool_input?.command||'';const dangerous=['rm -rf /','rm -rf ~','rm -rf ..','sudo rm','chmod 777','dd if=','mkfs',':(){ :|:& };:'];const hit=dangerous.find(d=>cmd.includes(d));if(hit){console.error('[GUARD] Tehlikeli komut engellendi: '+hit);process.exit(2);}\""
          }
        ]
      }
    ]
  }
}
