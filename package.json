{
  "name": "medisim-tr",
  "private": true,
  "version": "0.1.0",
  "description": "Türkiye'ye özel sanal hasta simülasyon platformu",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:visual": "playwright test dialog-3d-vision.spec.ts",
    "test:visual:update": "playwright test dialog-3d-vision.spec.ts --update-snapshots",
    "glb:inspect": "gltf-transform inspect",
    "glb:validate": "gltf-transform validate",
    "glb:patient": "gltf-transform optimize assets/3d-src/patient-master.glb public/3d/patient-mimikli.glb --compress meshopt --texture-compress webp --texture-size 2048 --simplify false --join false --weld true --prune true --instance false",
    "glb:room": "gltf-transform optimize assets/3d-src/room-master.glb public/3d/room.glb --compress meshopt --texture-compress webp --texture-size 1024 --simplify true --simplify-error 0.001 --join true --instance true",
    "glb:check": "node scripts/validate-glb.mjs",
    "measure:bed": "node scripts/measure-bed-place.mjs",
    "glb:gate": "node scripts/validate-glb.mjs public/3d/patient-mimikli.glb && npm run test:visual",
    "prepare": "husky"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@medplum/fhirtypes": "^5.1.17",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.5.0",
    "three": "^0.170.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.19",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "vitest related --run"
  }
}
